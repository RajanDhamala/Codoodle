NODE_ENV=development
PORT=3000

# Comma-separated browser origins allowed for HTTP and Socket.IO.
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

CLIENT_SECRET=replace-with-oauth-callback-secret
ACCESS_TOKEN_SECRET=replace-with-access-token-secret
REFRESH_TOKEN_SECRET=replace-with-refresh-token-secret
INFO_SECRET=replace-with-gameplay-info-cookie-secret

HTTP_JSON_LIMIT=32kb
WS_MAX_PAYLOAD_BYTES=20000
WS_RATE_LIMIT_WINDOW_MS=10000
WS_MAX_EVENTS_PER_WINDOW=80
WS_MAX_CHAT_MESSAGE_LENGTH=280
WS_MAX_POINTS_PER_SEND=32
